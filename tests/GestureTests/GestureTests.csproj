<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0 (NOT net8.0-windows) so tests run on any platform/CI -->
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>GestureTests</RootNamespace>
    <!-- Suppress CS8019 (unused using) warnings from included files -->
    <NoWarn>CS8019</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk"         Version="17.8.0" />
    <PackageReference Include="xunit"                          Version="2.6.3" />
    <PackageReference Include="xunit.runner.visualstudio"      Version="2.5.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector"             Version="6.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    Compile the pure-math sources directly from the main project.
    These files have NO WinForms / Windows-specific dependencies.
    This avoids adding a net8.0-windows project reference.
  -->
  <ItemGroup>
    <Compile Include="..\..\src\TouchpadGestureControl\Input\TouchPoint.cs" />
    <Compile Include="..\..\src\TouchpadGestureControl\Settings.cs" />
    <Compile Include="..\..\src\TouchpadGestureControl\Gesture\RotationCalculator.cs" />
  </ItemGroup>

</Project>

